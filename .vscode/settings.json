{
    "cSpell.customDictionaries": {
        "custom": true,
        "internal-terms": false,
        "project-words": {
            "addWords": true,
            "description": "Words used in this project",
            "name": "project-words",
            "path": "${workspaceRoot}/.vscode/project-words.txt"
        }
    },
    "explorerExclude.backup": {},
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        "**/.mypy_cache": true,
        "**/.pytest_cache": true,
        "**/__pycache__": true,
        ".github": true,
        ".typings": true,
        ".venv": true,
        ".vscode": true,
        ".ruff_cache": true,
        "**/.jj": true
    }
}